rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /courts/{courtId} {
      allow read: if true;
      allow write: if false;
    }

    match /clubs/{clubId} {
      allow read: if true;
      allow write: if false;
    }

    // Presence of a doc here (not its contents) grants admin — managed by
    // hand in the console, not through the app.
    match /admin/{userId} {
      allow read: if true;
      allow write: if false;
    }

    match /bookings/{bookingId} {
      allow read: if true;
      // Must be logged in, a booking always takes two players (no solo
      // bookings), and the booker must belong to the court's club.
      allow create: if request.auth != null
        && request.resource.data.partnerId is string
        && request.resource.data.partnerId.size() > 0
        // Courts without a club (legacy/unset) skip the membership check.
        && (get(/databases/$(database)/documents/courts/$(request.resource.data.courtId)).data.clubId == ''
          || get(/databases/$(database)/documents/courts/$(request.resource.data.courtId)).data.clubId in
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.clubIds);
      allow update: if true;
      allow delete: if false;
    }

    match /broadcasts/{broadcastId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if true;
    }

    match /messages/{messageId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if false;
    }

    // Real Firebase Auth is wired up, so unlike the collections above this
    // can (and should) be scoped to "only the owner can write their doc".
    match /users/{userId} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == userId;
      // The owner can change anything; anyone else signed in can only
      // append to `bookingIds` — needed when someone invites this user as
      // a booking partner, since that write happens from the inviter's
      // session, not this user's own.
      allow update: if request.auth != null && (
        request.auth.uid == userId ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['bookingIds'])
      );
      allow delete: if false;
    }
  }
}
