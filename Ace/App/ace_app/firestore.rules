rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /courts/{courtId} {
      allow read: if true;
      // Only admins (doc present at admin/{uid}) can create/edit courts,
      // and only for a club they're themselves a member of.
      allow create: if request.auth != null
        && exists(/databases/$(database)/documents/admin/$(request.auth.uid))
        && request.resource.data.clubId in
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.clubIds;
      allow update: if request.auth != null
        && exists(/databases/$(database)/documents/admin/$(request.auth.uid))
        && resource.data.clubId in
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.clubIds
        && request.resource.data.clubId in
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.clubIds;
      // Same admin/club scoping as update — only the admin of that club can
      // delete the court.
      allow delete: if request.auth != null
        && exists(/databases/$(database)/documents/admin/$(request.auth.uid))
        && resource.data.clubId in
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.clubIds;
    }

    match /bookingScenarios/{scenarioId} {
      allow read: if true;
      // Same admin/club scoping as `courts` — only an admin of the
      // scenario's own club can create/edit/delete it.
      allow create: if request.auth != null
        && exists(/databases/$(database)/documents/admin/$(request.auth.uid))
        && request.resource.data.clubId in
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.clubIds;
      allow update: if request.auth != null
        && exists(/databases/$(database)/documents/admin/$(request.auth.uid))
        && resource.data.clubId in
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.clubIds
        && request.resource.data.clubId in
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.clubIds;
      allow delete: if request.auth != null
        && exists(/databases/$(database)/documents/admin/$(request.auth.uid))
        && resource.data.clubId in
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.clubIds;
    }

    match /clubs/{clubId} {
      allow read: if true;
      // Only an admin of this club can edit it (e.g. its image) — clubs
      // aren't created/deleted through the app, only pre-seeded, so create
      // and delete stay closed.
      allow update: if request.auth != null
        && exists(/databases/$(database)/documents/admin/$(request.auth.uid))
        && clubId in
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.clubIds;
      allow create: if false;
      allow delete: if false;
    }

    match /events/{eventId} {
      allow read: if true;
      // Only an admin can create an event, and only for a club they're
      // themselves a member of.
      allow create: if request.auth != null
        && exists(/databases/$(database)/documents/admin/$(request.auth.uid))
        && request.resource.data.clubId in
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.clubIds;
      // Same admin/club scoping for a full edit; any signed-in user can
      // otherwise only toggle themselves in/out of `participantIds`.
      allow update: if request.auth != null && (
        (exists(/databases/$(database)/documents/admin/$(request.auth.uid))
          && resource.data.clubId in
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.clubIds
          && request.resource.data.clubId in
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.clubIds)
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participantIds'])
      );
      // Same admin/club scoping as update — only the admin of that club can
      // delete the event.
      allow delete: if request.auth != null
        && exists(/databases/$(database)/documents/admin/$(request.auth.uid))
        && resource.data.clubId in
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.clubIds;
    }

    match /tournaments/{tournamentId} {
      allow read: if true;
      // Same admin/club scoping as `events` — only an admin of the
      // tournament's own club can create it.
      allow create: if request.auth != null
        && exists(/databases/$(database)/documents/admin/$(request.auth.uid))
        && request.resource.data.clubId in
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.clubIds;
      // The admin can fully edit (title, status, bracket, scheduling) as
      // long as they stay within their own club; any signed-in user can
      // otherwise only toggle themselves in/out of `participantIds`
      // (self-registration).
      allow update: if request.auth != null && (
        (exists(/databases/$(database)/documents/admin/$(request.auth.uid))
          && resource.data.clubId in
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.clubIds
          && request.resource.data.clubId in
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.clubIds)
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participantIds'])
      );
      allow delete: if request.auth != null
        && exists(/databases/$(database)/documents/admin/$(request.auth.uid))
        && resource.data.clubId in
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.clubIds;
    }

    // Non-admin people an admin has chosen to surface as club contacts on
    // players' profiles (e.g. a treasurer, a coach) — same admin/club
    // scoping as `tournaments` above. Editing a `roleLabel` is a
    // delete-then-recreate from the app, so no `update` is needed.
    match /clubContacts/{contactId} {
      allow read: if true;
      allow create: if request.auth != null
        && exists(/databases/$(database)/documents/admin/$(request.auth.uid))
        && request.resource.data.clubId in
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.clubIds;
      allow update: if false;
      allow delete: if request.auth != null
        && exists(/databases/$(database)/documents/admin/$(request.auth.uid))
        && resource.data.clubId in
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.clubIds;
    }

    // Presence of a doc here (not its contents) grants admin — managed by
    // hand in the console, not through the app.
    match /admin/{userId} {
      allow read: if true;
      allow write: if false;
    }

    // In-app "bell" notifications — created server-side alongside the
    // matching push (see functions/lib/notifications.js). Private to their
    // owner; the client may only flip `seen`/`clicked`, nothing else.
    match /notifications/{notificationId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if false;
      allow update: if request.auth != null
        && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seen', 'clicked']);
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // Support contact info, entered by hand in the console — same idiom
    // as `admin` above.
    match /SAV/{id} {
      allow read: if true;
      allow write: if false;
    }

    match /bookings/{bookingId} {
      allow read: if true;
      // Every booking-creation rule (club membership, court closures, each
      // court's configurable `BookingPolicy` limits) is now enforced by the
      // `createBooking` Cloud Function, which writes with Admin SDK
      // privileges and so bypasses this rule entirely — a direct client
      // write is never valid.
      allow create: if false;
      allow update: if true;
      allow delete: if false;
    }

    match /broadcasts/{broadcastId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if true;
    }

    match /messages/{messageId} {
      allow read: if true;
      // A club's announcement channel (conversationId `club_broadcast_<clubId>`)
      // is write-restricted to an admin of that same club; any other
      // conversationId is a regular 1:1 DM, open to any signed-in write.
      allow create: if
        !request.resource.data.conversationId.matches('^club_broadcast_.*')
        || (request.auth != null
          && exists(/databases/$(database)/documents/admin/$(request.auth.uid))
          && request.resource.data.conversationId.split('club_broadcast_')[1] in
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.clubIds);
      // Update also covers marking as read (any participant), so it stays
      // unrestricted like the rest of this collection; the app only shows
      // the edit action on the sender's own bubble.
      allow update: if true;
      // The sender can delete their own message (editing/removing a single
      // message); any participant can delete any message in the
      // conversation (deleting the whole conversation removes every
      // message, not just the ones they sent).
      allow delete: if request.auth != null
        && (resource.data.senderId == request.auth.uid
          || request.auth.uid in resource.data.participantIds);
    }

    // Real Firebase Auth is wired up, so unlike the collections above this
    // can (and should) be scoped to "only the owner can write their doc".
    match /users/{userId} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == userId;
      // The owner can change anything; anyone else signed in can only
      // append to `bookingIds` — needed when someone invites this user as
      // a booking partner, since that write happens from the inviter's
      // session, not this user's own.
      allow update: if request.auth != null && (
        request.auth.uid == userId ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['bookingIds'])
      );
      allow delete: if false;
    }
  }
}
