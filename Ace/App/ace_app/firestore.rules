rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /courts/{courtId} {
      allow read: if true;
      allow write: if false;
    }

    match /bookings/{bookingId} {
      allow read: if true;
      // Must be logged in, and a booking always takes two players — no
      // solo bookings, matching the "2 players" rule enforced client-side.
      allow create: if request.auth != null
        && request.resource.data.partnerId is string
        && request.resource.data.partnerId.size() > 0;
      allow update: if true;
      allow delete: if false;
    }

    match /broadcasts/{broadcastId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if true;
    }

    match /messages/{messageId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if false;
    }

    // Real Firebase Auth is wired up, so unlike the collections above this
    // can (and should) be scoped to "only the owner can write their doc".
    match /users/{userId} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == userId;
      // The owner can change anything; anyone else signed in can only
      // append to `bookingIds` — needed when someone invites this user as
      // a booking partner, since that write happens from the inviter's
      // session, not this user's own.
      allow update: if request.auth != null && (
        request.auth.uid == userId ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['bookingIds'])
      );
      allow delete: if false;
    }
  }
}
