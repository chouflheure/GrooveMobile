rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /courts/{courtId} {
      allow read: if true;
      allow write: if false;
    }

    // No Firebase Auth wired up yet, so this can't be scoped to "own
    // bookings" via request.auth — tighten once auth exists.
    match /bookings/{bookingId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if false;
    }

    match /broadcasts/{broadcastId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if true;
    }

    match /messages/{messageId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if false;
    }

    // Real Firebase Auth is wired up, so unlike the collections above this
    // can (and should) be scoped to "only the owner can write their doc".
    match /users/{userId} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;
    }
  }
}
